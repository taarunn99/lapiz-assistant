// lb_sync_so_shipment v2.2 (2 Oct 2026: orphan sweep when every SO line is removed, package date never before SO date, one alert not two) | Zoho Books | Dubai org 719219457 | Module: Invoice
// Rule: "Invoice is created or edited" (any field). One function handles create, edit and void.
//
// What it does, in one sentence: for every sales order behind this invoice, keep exactly one
// package + one shipment (marked Delivered) that mirrors the invoice's current lines, and when the
// invoice is voided, bring the goods back with a Sales Return received in full.
//
//  - Invoice saved with SO lines        -> package + shipment for those quantities, shipment marked Delivered
//  - Invoice edited (qty up or down)    -> old mirror removed, new mirror built from current lines, Delivered again
//  - Invoice voided                     -> shipment is KEPT, a Sales Return for the invoice quantities is created
//                                          dated the day of the void, received into the same warehouse as the SO line
//  - Run again with nothing changed     -> compares and does nothing (safe to re-fire)
//  - Anything odd (drop ship, batch or serial item, manual package in the way, API error)
//                                       -> nothing destructive, an ALERT comment is posted on the SO
//
// Only packages whose notes carry the marker LB-STOCKSYNC and this invoice's id are ever deleted.
// Hand made packages are never touched. Sales returns are never deleted by this function.
// Zoho sometimes answers "The requested action could not be completed. Please try again." when two
// invoices on the same sales order are saved at the same moment; every write here is retried 3 times.

// STAGE 1 (6 Oct 2026, Tarun's go): ZZ TEST customers + FIRST_CUSTOMERS only. STAGE 2: every customer.
// The workflow rule "LB stock sync on invoice" has no customer criterion from stage 1 on; this gate is the only filter.
STAGE = 1;
FIRST_CUSTOMERS = {"2305879000025783189","2305879000148166333","2305879000022370257"};
FIRST_NAMES = {"LAPIZ BLUE GENERAL TRADING LLC - ABU DHABI","GLOBAL CLASSIC BUILDING MATERIALS TRADING L.L.C","MONTOLITE BUILDING MATERIAL TRADING LLC"};
// 2305879000025783189 = LAPIZ BLUE GENERAL TRADING LLC - ABU DHABI (own branch)
// 2305879000148166333 = GLOBAL CLASSIC BUILDING MATERIALS TRADING L.L.C (group company)
// 2305879000022370257 = MONTOLITE BUILDING MATERIAL TRADING LLC (regular trade customer)
// connection "lb_inventory": Books connection, Zoho Inventory service, authorised by Adil (Deluge needs it as a literal)
API = "https://www.zohoapis.com/inventory/v1";
MARK = "LB-STOCKSYNC";
DELIVERY_METHOD = "Al Quoz";
TRIES = {1,2,3};

orgId = organization.get("organization_id");
invId = invoice.get("invoice_id").toString();
invNum = ifnull(invoice.get("invoice_number"),"");
invStatus = ifnull(invoice.get("status"),"").toLowerCase();
custName = ifnull(invoice.get("customer_name"),"");
today = zoho.currentdate.toString("yyyy-MM-dd");

custKey = ifnull(invoice.get("customer_id"),"").toString();
if(STAGE == 1 && custName.startsWith("ZZ TEST") == false && FIRST_CUSTOMERS.contains(custKey) == false && FIRST_NAMES.contains(custName) == false)
{
	info "skip (stage 1): " + invNum + " customer " + custName;
	return;
}
if(invStatus == "draft" || invStatus == "pending_approval")
{
	info "skip: " + invNum + " is " + invStatus;
	return;
}
isVoid = false;
if(invStatus == "void")
{
	isVoid = true;
}
// ---------- 1. full invoice: SO links are not in the trigger map ----------
r = invokeurl
[
	url :API + "/invoices/" + invId + "?organization_id=" + orgId
	type :GET
	connection:"lb_inventory"
];
if(ifnull(r.get("code"),-1) != 0)
{
	info "ERROR fetch invoice " + invNum + ": " + r.get("message");
	return;
}
inv = r.get("invoice");
invDate = ifnull(inv.get("date"),today);
invMod = ifnull(inv.get("last_modified_time"),"");
soIds = List();
for each  s in ifnull(inv.get("salesorders"),List())
{
	sid = ifnull(s.get("salesorder_id"),"").toString();
	if(sid != "" && soIds.contains(sid) == false)
	{
		soIds.add(sid);
	}
}
hdrSo = ifnull(inv.get("salesorder_id"),"").toString();
if(hdrSo != "" && soIds.contains(hdrSo) == false)
{
	soIds.add(hdrSo);
}
if(soIds.size() == 0)
{
	// Either a standalone invoice (Books moves the stock itself) or an edit removed EVERY sales order line,
	// in which case Zoho drops the link and our mirror package would be left behind (2 Oct 2026, test L16).
	// Look through this customer's packages dated on the invoice date for our marker and remove that package.
	swept = 0;
	custId = ifnull(inv.get("customer_id"),"").toString();
	if(isVoid == false && custId != "")
	{
		pl = invokeurl
		[
			url :API + "/packages?organization_id=" + orgId + "&customer_id=" + custId + "&date_start=" + invDate + "&date_end=" + invDate + "&per_page=200"
			type :GET
			connection:"lb_inventory"
		];
		for each  pk0 in ifnull(pl.get("packages"),List())
		{
			pid0 = ifnull(pk0.get("package_id"),"").toString();
			pr0 = invokeurl
			[
				url :API + "/packages/" + pid0 + "?organization_id=" + orgId
				type :GET
				connection:"lb_inventory"
			];
			if(ifnull(pr0.get("code"),-1) != 0)
			{
				continue;
			}
			p0 = pr0.get("package");
			n0 = ifnull(p0.get("notes"),"");
			if(n0.contains(MARK) && n0.contains("inv:" + invId))
			{
				sh0 = ifnull(p0.get("shipment_id"),"").toString();
				ok0 = true;
				if(sh0 != "")
				{
					d0 = invokeurl
					[
						url :API + "/shipmentorders/" + sh0 + "?organization_id=" + orgId
						type :DELETE
						connection:"lb_inventory"
					];
					if(ifnull(d0.get("code"),-1) != 0)
					{
						ok0 = false;
						info "ERROR " + invNum + ": could not delete orphan shipment of " + p0.get("package_number") + ": " + d0.get("message");
					}
				}
				if(ok0)
				{
					d0 = invokeurl
					[
						url :API + "/packages/" + pid0 + "?organization_id=" + orgId
						type :DELETE
						connection:"lb_inventory"
					];
					if(ifnull(d0.get("code"),-1) == 0)
					{
						swept = swept + 1;
						info invNum + ": no sales order lines left, removed orphan mirror package " + p0.get("package_number");
					}
					else
					{
						info "ERROR " + invNum + ": could not delete orphan package " + p0.get("package_number") + ": " + d0.get("message");
					}
				}
			}
		}
	}
	if(swept == 0)
	{
		info "skip: " + invNum + " has no sales order (standalone invoice, stock handled by Books preference)";
	}
	return;
}
// ---------- 2. invoice lines: so_line_item_id -> qty ----------
// live invoice: this is what must be packed and shipped
// void invoice: this is what must come back as a sales return
want = Map();
for each  il in ifnull(inv.get("line_items"),List())
{
	lid = ifnull(il.get("salesorder_item_id"),"").toString();
	if(lid != "" && ifnull(il.get("item_type"),"") == "inventory")
	{
		q = ifnull(il.get("quantity"),0).toDecimal();
		if(want.containKey(lid))
		{
			q = q + want.get(lid);
		}
		want.put(lid,q);
	}
}
noteText = MARK + " inv:" + invId + " " + invNum + " mod:" + invMod;
voidNote = MARK + " void inv:" + invId + " " + invNum;
// ---------- 3. per sales order ----------
for each  soId in soIds
{
	alert = "";
	r = invokeurl
	[
		url :API + "/salesorders/" + soId + "?organization_id=" + orgId
		type :GET
		connection:"lb_inventory"
	];
	if(ifnull(r.get("code"),-1) != 0)
	{
		info "ERROR fetch SO " + soId + ": " + r.get("message");
		continue;
	}
	so = r.get("salesorder");
	soNum = ifnull(so.get("salesorder_number"),"");
	soStatus = ifnull(so.get("status"),"");
	// Zoho refuses a package dated before its sales order (2 Oct 2026, test L20): use the later of the two dates
	pkDate = invDate;
	soDate = ifnull(so.get("date"),"");
	if(soDate != "" && soDate.toDate() > invDate.toDate())
	{
		pkDate = soDate;
	}
	if(ifnull(so.get("is_dropshipped"),false) == true)
	{
		alert = "drop ship sales order, no shipment created";
	}
	if(soStatus == "void" || soStatus == "draft")
	{
		alert = "sales order is " + soStatus;
	}
	lines = Map();
	for each  sl in ifnull(so.get("line_items"),List())
	{
		lid = ifnull(sl.get("line_item_id"),"").toString();
		lines.put(lid,sl);
		if(ifnull(sl.get("batches"),List()).size() > 0 || ifnull(sl.get("serial_numbers"),List()).size() > 0)
		{
			alert = "batch or serial tracked item " + ifnull(sl.get("name"),"") + ", pack manually";
		}
	}
	// lines of this invoice that belong to this SO
	soWant = Map();
	for each  lid in want.keys()
	{
		if(lines.containKey(lid))
		{
			soWant.put(lid,want.get(lid));
		}
	}
	// =====================================================================================
	// VOID: keep the shipment, bring the goods back with one sales return, received in full
	// =====================================================================================
	if(isVoid)
	{
		// 3v-a. did this function already make the return for this void? (safe to re-fire)
		done = "";
		for each  sr in ifnull(so.get("salesreturns"),List())
		{
			srid = ifnull(sr.get("salesreturn_id"),"").toString();
			srr = invokeurl
			[
				url :API + "/salesreturns/" + srid + "?organization_id=" + orgId
				type :GET
				connection:"lb_inventory"
			];
			if(ifnull(srr.get("code"),-1) != 0)
			{
				continue;
			}
			// Zoho does not keep notes on a sales return, so the marker lives in the reason (1 Oct 2026)
			notes = ifnull(srr.get("salesreturn").get("reason"),"") + " " + ifnull(srr.get("salesreturn").get("notes"),"");
			if(notes.contains(MARK) && notes.contains("void inv:" + invId))
			{
				done = ifnull(srr.get("salesreturn").get("salesreturn_number"),srid);
			}
		}
		if(done != "")
		{
			info soNum + ": void of " + invNum + " already returned as " + done;
			continue;
		}
		if(alert != "")
		{
			c = Map();
			c.put("description",MARK + " ALERT (" + invNum + " void): " + alert);
			cr2 = invokeurl
			[
				url :API + "/salesorders/" + soId + "/comments?organization_id=" + orgId
				type :POST
				parameters:c.toString()
				connection:"lb_inventory"
			];
			info soNum + " ALERT: " + alert;
			continue;
		}
		// 3v-b. how much of each line can still come back: shipped and not yet returned
		retLines = List();
		short = "";
		nothing = true;
		for each  lid in soWant.keys()
		{
			sl = ifnull(lines.get(lid),Map());
			shipped = ifnull(sl.get("quantity_shipped"),0).toDecimal();
			returned = ifnull(sl.get("quantity_returned"),0).toDecimal();
			room = shipped - returned;
			q = soWant.get(lid);
			if(shipped > 0)
			{
				nothing = false;
			}
			if(q > room)
			{
				short = short + ifnull(sl.get("name"),lid) + " invoice qty " + q + " but only " + room + " shipped and not yet returned; ";
				q = room;
			}
			if(q > 0)
			{
				li = Map();
				li.put("salesorder_item_id",lid);
				li.put("item_id",ifnull(sl.get("item_id"),"").toString());
				li.put("quantity",q);
				// same warehouse as the SO line; without this Zoho puts the return into Al Quoz (matrix T08, T17)
				loc = ifnull(sl.get("location_id"),"").toString();
				if(loc != "")
				{
					li.put("location_id",loc);
				}
				retLines.add(li);
			}
		}
		if(nothing)
		{
			info soNum + ": " + invNum + " voided but nothing was shipped for it, no return needed";
			continue;
		}
		if(short != "")
		{
			alert = "return capped: " + short;
		}
		// 3v-c. create the sales return (retry on Zoho's "please try again")
		if(retLines.size() > 0)
		{
			body = Map();
			body.put("salesorder_id",soId);
			body.put("date",today);
			body.put("reason","Invoice " + invNum + " voided | " + voidNote);
			body.put("notes",voidNote);
			body.put("line_items",retLines);
			soLoc = ifnull(so.get("location_id"),"").toString();
			if(soLoc != "")
			{
				body.put("location_id",soLoc);
			}
			cr = Map();
			for each  t in TRIES
			{
				cr = invokeurl
				[
					url :API + "/salesreturns?organization_id=" + orgId + "&salesorder_id=" + soId
					type :POST
					parameters:body.toString()
					connection:"lb_inventory"
				];
				if(ifnull(cr.get("code"),-1) == 0)
				{
					break;
				}
				if(ifnull(cr.get("message"),"").containsIgnoreCase("try again") == false)
				{
					break;
				}
				info soNum + ": sales return attempt " + t + " busy, retrying";
			}
			if(ifnull(cr.get("code"),-1) != 0)
			{
				alert = "sales return create failed: " + cr.get("message");
			}
			else
			{
				sret = cr.get("salesreturn");
				srid = sret.get("salesreturn_id").toString();
				// 3v-d. receive it in full, into the warehouse of each SO line
				rcvLines = List();
				for each  rl in ifnull(sret.get("line_items"),List())
				{
					x = Map();
					x.put("line_item_id",ifnull(rl.get("line_item_id"),"").toString());
					x.put("quantity",ifnull(rl.get("quantity"),0).toDecimal());
					rcvLines.add(x);
				}
				rb = Map();
				rb.put("salesreturn_id",srid);
				rb.put("date",today);
				rb.put("notes",voidNote);
				rb.put("line_items",rcvLines);
				rr = Map();
				for each  t in TRIES
				{
					rr = invokeurl
					[
						url :API + "/salesreturnreceives?organization_id=" + orgId + "&salesreturn_id=" + srid
						type :POST
						parameters:rb.toString()
						connection:"lb_inventory"
					];
					if(ifnull(rr.get("code"),-1) == 0)
					{
						break;
					}
					if(ifnull(rr.get("message"),"").containsIgnoreCase("try again") == false)
					{
						break;
					}
					info soNum + ": receive attempt " + t + " busy, retrying";
				}
				if(ifnull(rr.get("code"),-1) != 0)
				{
					alert = "return " + sret.get("salesreturn_number") + " created but receive failed: " + rr.get("message");
				}
				else
				{
					info soNum + ": " + invNum + " voided -> sales return " + sret.get("salesreturn_number") + " received into stock";
				}
			}
		}
		if(alert != "")
		{
			c = Map();
			c.put("description",MARK + " ALERT (" + invNum + " void): " + alert);
			cr2 = invokeurl
			[
				url :API + "/salesorders/" + soId + "/comments?organization_id=" + orgId
				type :POST
				parameters:c.toString()
				connection:"lb_inventory"
			];
			info soNum + " ALERT: " + alert;
		}
		continue;
	}
	// =====================================================================================
	// CREATE or EDIT: one package + one delivered shipment that mirrors the invoice lines
	// =====================================================================================
	// ---------- 3a. find the mirror package(s) this function made earlier for this invoice ----------
	mine = List();
	for each  pk in ifnull(so.get("packages"),List())
	{
		pid = ifnull(pk.get("package_id"),"").toString();
		pr = invokeurl
		[
			url :API + "/packages/" + pid + "?organization_id=" + orgId
			type :GET
			connection:"lb_inventory"
		];
		if(ifnull(pr.get("code"),-1) != 0)
		{
			continue;
		}
		p = pr.get("package");
		notes = ifnull(p.get("notes"),"");
		if(notes.contains(MARK) && notes.contains("inv:" + invId))
		{
			have = Map();
			for each  pl in ifnull(p.get("line_items"),List())
			{
				plid = ifnull(pl.get("so_line_item_id"),"").toString();
				hq = ifnull(pl.get("quantity"),0).toDecimal();
				if(have.containKey(plid))
				{
					hq = hq + have.get(plid);
				}
				have.put(plid,hq);
			}
			m = Map();
			m.put("package_id",pid);
			m.put("package_number",ifnull(p.get("package_number"),""));
			m.put("shipment_id",ifnull(p.get("shipment_id"),"").toString());
			m.put("have",have);
			mine.add(m);
		}
	}
	// ---------- 3b. already in sync? ----------
	same = false;
	if(mine.size() == 0 && soWant.size() == 0)
	{
		same = true;
	}
	if(mine.size() == 1)
	{
		have = mine.get(0).get("have");
		same = false;
		if(have.size() == soWant.size())
		{
			same = true;
		}
		if(same)
		{
			for each  lid in soWant.keys()
			{
				if(have.containKey(lid) == false)
				{
					same = false;
				}
				else if(have.get(lid) != soWant.get(lid))
				{
					same = false;
				}
			}
		}
	}
	if(same)
	{
		info soNum + ": already in sync with " + invNum;
		continue;
	}
	if(alert != "")
	{
		// do nothing destructive, just tell a human
		c = Map();
		c.put("description",MARK + " ALERT (" + invNum + "): " + alert);
		cr2 = invokeurl
		[
			url :API + "/salesorders/" + soId + "/comments?organization_id=" + orgId
			type :POST
			parameters:c.toString()
			connection:"lb_inventory"
		];
		info soNum + " ALERT: " + alert;
		continue;
	}
	// ---------- 3c. remove old mirror (shipment first, then package). Zoho lets a Delivered shipment be deleted directly ----------
	for each  m in mine
	{
		shId = m.get("shipment_id");
		if(shId != "" && alert == "")
		{
			d = Map();
			for each  t in TRIES
			{
				d = invokeurl
				[
					url :API + "/shipmentorders/" + shId + "?organization_id=" + orgId
					type :DELETE
					connection:"lb_inventory"
				];
				if(ifnull(d.get("code"),-1) == 0)
				{
					break;
				}
				if(ifnull(d.get("message"),"").containsIgnoreCase("try again") == false)
				{
					break;
				}
				info soNum + ": delete shipment attempt " + t + " busy, retrying";
			}
			if(ifnull(d.get("code"),-1) != 0)
			{
				alert = "could not delete shipment of package " + m.get("package_number") + ": " + d.get("message");
			}
		}
		if(alert == "")
		{
			d = Map();
			for each  t in TRIES
			{
				d = invokeurl
				[
					url :API + "/packages/" + m.get("package_id") + "?organization_id=" + orgId
					type :DELETE
					connection:"lb_inventory"
				];
				if(ifnull(d.get("code"),-1) == 0)
				{
					break;
				}
				if(ifnull(d.get("message"),"").containsIgnoreCase("try again") == false)
				{
					break;
				}
				info soNum + ": delete package attempt " + t + " busy, retrying";
			}
			if(ifnull(d.get("code"),-1) != 0)
			{
				alert = "could not delete package " + m.get("package_number") + ": " + d.get("message");
			}
			else
			{
				info soNum + ": removed old mirror package " + m.get("package_number") + " for " + invNum;
			}
		}
	}
	// ---------- 3d. build new mirror ----------
	if(alert == "" && soWant.size() > 0)
	{
		// fresh numbers after the deletions, so we never pack more than the SO has room for
		r2 = invokeurl
		[
			url :API + "/salesorders/" + soId + "?organization_id=" + orgId
			type :GET
			connection:"lb_inventory"
		];
		fresh = Map();
		for each  sl in ifnull(ifnull(r2.get("salesorder"),Map()).get("line_items"),List())
		{
			fresh.put(ifnull(sl.get("line_item_id"),"").toString(),sl);
		}
		pkgLines = List();
		short = "";
		for each  lid in soWant.keys()
		{
			sl = ifnull(fresh.get(lid),Map());
			room = ifnull(sl.get("quantity_invoiced"),0).toDecimal() - ifnull(sl.get("quantity_packed"),0).toDecimal();
			q = soWant.get(lid);
			if(q > room)
			{
				short = short + ifnull(sl.get("name"),lid) + " invoice qty " + q + " but only " + room + " left to pack; ";
				q = room;
			}
			if(q > 0)
			{
				li = Map();
				li.put("so_line_item_id",lid);
				li.put("quantity",q);
				pkgLines.add(li);
			}
		}
		if(short != "")
		{
			alert = "partly covered by another package already: " + short;
		}
		if(pkgLines.size() > 0)
		{
			body = Map();
			body.put("date",pkDate);
			body.put("notes",noteText);
			body.put("line_items",pkgLines);
			cr = Map();
			for each  t in TRIES
			{
				cr = invokeurl
				[
					url :API + "/packages?organization_id=" + orgId + "&salesorder_id=" + soId
					type :POST
					parameters:body.toString()
					connection:"lb_inventory"
				];
				if(ifnull(cr.get("code"),-1) == 0)
				{
					break;
				}
				if(ifnull(cr.get("message"),"").containsIgnoreCase("try again") == false)
				{
					break;
				}
				info soNum + ": package attempt " + t + " busy, retrying";
			}
			if(ifnull(cr.get("code"),-1) != 0)
			{
				alert = "package create failed: " + cr.get("message");
			}
			else
			{
				pkg = cr.get("package");
				pid = pkg.get("package_id").toString();
				// ---------- 3d-2. duplicate guard ----------
				// Two saves in one second run this function twice at once, and both can create a package for this
				// invoice (test L09, 1 Oct 2026: two packages of 4 for one invoice of 4). Keep the oldest one (lowest id),
				// remove our own if an older mirror for this invoice exists. Ours has no shipment yet, so this is safe.
				dup = "";
				r4 = invokeurl
				[
					url :API + "/salesorders/" + soId + "?organization_id=" + orgId
					type :GET
					connection:"lb_inventory"
				];
				for each  pk4 in ifnull(ifnull(r4.get("salesorder"),Map()).get("packages"),List())
				{
					pid4 = ifnull(pk4.get("package_id"),"").toString();
					if(pid4 != "" && pid4 != pid && pid4.toLong() < pid.toLong())
					{
						pr4 = invokeurl
						[
							url :API + "/packages/" + pid4 + "?organization_id=" + orgId
							type :GET
							connection:"lb_inventory"
						];
						if(ifnull(pr4.get("code"),-1) == 0)
						{
							n4 = ifnull(pr4.get("package").get("notes"),"");
							if(n4.contains(MARK) && n4.contains("inv:" + invId))
							{
								dup = ifnull(pr4.get("package").get("package_number"),pid4);
							}
						}
					}
				}
				if(dup != "")
				{
					d4 = invokeurl
					[
						url :API + "/packages/" + pid + "?organization_id=" + orgId
						type :DELETE
						connection:"lb_inventory"
					];
					info soNum + ": " + invNum + " package " + pkg.get("package_number") + " removed again, a parallel run already made " + dup + " (" + ifnull(d4.get("message"),"") + ")";
				}
				else
				{
				sb = Map();
				sb.put("date",pkDate);
				sb.put("delivery_method",DELIVERY_METHOD);
				sb.put("notes",noteText);
				sr = Map();
				for each  t in TRIES
				{
					sr = invokeurl
					[
						url :API + "/shipmentorders?organization_id=" + orgId + "&package_ids=" + pid + "&salesorder_id=" + soId + "&send_notification=false"
						type :POST
						parameters:sb.toString()
						connection:"lb_inventory"
					];
					if(ifnull(sr.get("code"),-1) == 0)
					{
						break;
					}
					if(ifnull(sr.get("message"),"").containsIgnoreCase("try again") == false)
					{
						break;
					}
					info soNum + ": shipment attempt " + t + " busy, retrying";
				}
				if(ifnull(sr.get("code"),-1) != 0)
				{
					alert = "package " + pkg.get("package_number") + " created but shipment failed: " + sr.get("message");
				}
				else
				{
					ship = ifnull(sr.get("shipmentorder"),Map());
					shId = ifnull(ship.get("shipmentorder_id"),ifnull(ship.get("shipment_id"),"")).toString();
					// ---------- 3e. mark the shipment Delivered ----------
					delivered = "";
					if(shId != "")
					{
						dr = Map();
						for each  t in TRIES
						{
							dr = invokeurl
							[
								url :API + "/shipmentorders/" + shId + "/status/delivered?organization_id=" + orgId
								type :POST
								connection:"lb_inventory"
							];
							if(ifnull(dr.get("code"),-1) == 0)
							{
								break;
							}
							if(ifnull(dr.get("message"),"").containsIgnoreCase("try again") == false)
							{
								break;
							}
							info soNum + ": deliver attempt " + t + " busy, retrying";
						}
						if(ifnull(dr.get("code"),-1) == 0)
						{
							delivered = " (delivered)";
						}
						else
						{
							alert = "shipment " + ifnull(ship.get("shipment_number"),"") + " created but could not be marked delivered: " + dr.get("message");
						}
					}
					info soNum + ": " + invNum + " -> package " + pkg.get("package_number") + ", shipment " + ifnull(ship.get("shipment_number"),"") + delivered;
				}
				}
			}
		}
	}
	// ---------- 3f. before alerting, look once more ----------
	// Two saves in one second (Approve and Send, or two edits) run this function twice at the same time.
	// The other run may already have built the mirror, so our failure is not a real problem (1 Oct 2026, test L01).
	if(alert != "")
	{
		r3 = invokeurl
		[
			url :API + "/salesorders/" + soId + "?organization_id=" + orgId
			type :GET
			connection:"lb_inventory"
		];
		so3 = ifnull(r3.get("salesorder"),Map());
		mine3 = 0;
		have3 = Map();
		for each  pk in ifnull(so3.get("packages"),List())
		{
			pid = ifnull(pk.get("package_id"),"").toString();
			pr = invokeurl
			[
				url :API + "/packages/" + pid + "?organization_id=" + orgId
				type :GET
				connection:"lb_inventory"
			];
			if(ifnull(pr.get("code"),-1) != 0)
			{
				continue;
			}
			p = pr.get("package");
			notes = ifnull(p.get("notes"),"");
			if(notes.contains(MARK) && notes.contains("inv:" + invId))
			{
				mine3 = mine3 + 1;
				for each  pl in ifnull(p.get("line_items"),List())
				{
					plid = ifnull(pl.get("so_line_item_id"),"").toString();
					hq = ifnull(pl.get("quantity"),0).toDecimal();
					if(have3.containKey(plid))
					{
						hq = hq + have3.get(plid);
					}
					have3.put(plid,hq);
				}
			}
		}
		ok3 = false;
		if(mine3 == 0 && soWant.size() == 0)
		{
			ok3 = true;
		}
		if(mine3 == 1 && have3.size() == soWant.size())
		{
			ok3 = true;
			for each  lid in soWant.keys()
			{
				if(have3.containKey(lid) == false)
				{
					ok3 = false;
				}
				else if(have3.get(lid) != soWant.get(lid))
				{
					ok3 = false;
				}
			}
		}
		if(ok3)
		{
			info soNum + ": " + invNum + " already in sync, a parallel run did it. Dropped alert: " + alert;
			alert = "";
		}
	}
	if(alert != "")
	{
		// two runs at the same moment (approve + send) would post the same alert twice: post it only if it is not there yet
		txt = MARK + " ALERT (" + invNum + "): " + alert;
		seen = false;
		cl = invokeurl
		[
			url :API + "/salesorders/" + soId + "/comments?organization_id=" + orgId
			type :GET
			connection:"lb_inventory"
		];
		for each  cm in ifnull(cl.get("comments"),List())
		{
			if(ifnull(cm.get("description"),"") == txt)
			{
				seen = true;
			}
		}
		if(seen)
		{
			info soNum + " ALERT already posted: " + alert;
		}
		else
		{
			c = Map();
			c.put("description",txt);
			cr2 = invokeurl
			[
				url :API + "/salesorders/" + soId + "/comments?organization_id=" + orgId
				type :POST
				parameters:c.toString()
				connection:"lb_inventory"
			];
			info soNum + " ALERT: " + alert;
		}
	}
}
